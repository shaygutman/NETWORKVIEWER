# Copy to .env and adjust for your environment
AUTH_MODE=ldap
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480

# Mock login (only when AUTH_MODE=mock)
MOCK_USERNAME=admin
MOCK_PASSWORD=admin

# Medtronic ENT Active Directory
LDAP_SERVER=hcwe6f520b1.ent.core.medtronic.com
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_FQDN=ent.core.medtronic.com
LDAP_BASE_DN=DC=ent,DC=core,DC=medtronic,DC=com
LDAP_USER_SEARCH_BASE=DC=ent,DC=core,DC=medtronic,DC=com
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_ALLOWED_GROUP=
LDAP_DOMAIN=ENT
LDAP_UPN_SUFFIX=ent.core.medtronic.com

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
SSH_TIMEOUT=5
SSH_CONN_TIMEOUT=3
COLLECTOR_MAX_WORKERS=8
# Sticky cache freshness window (GUI never SSHs on normal GET).
COLLECTOR_CACHE_TTL_SECONDS=1800
# Background read-only poll interval (seconds). Suggested 300–900 (5–15 min).
COLLECTOR_POLL_INTERVAL_SECONDS=600
COLLECTOR_POLL_ENABLED=true
# Optional dedicated poller account (read-only AAA). If empty, uses an active UI session.
POLLER_SSH_USERNAME=
POLLER_SSH_PASSWORD=
# Durable local cache (snapshots + unused-port history). Independent of switch uptime.
# CACHE_DB_PATH=backend/data/nms_cache.db
STALE_PORT_DAYS=30
